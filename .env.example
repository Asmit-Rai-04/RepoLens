# RepoLens backend configuration. Copy to .env to override any value.
APP_NAME=RepoLens
APP_ENV=development
LOG_LEVEL=INFO

# Ingestion limits (bytes unless noted).
MAX_REPOSITORY_BYTES=104857600
MAX_ARCHIVE_BYTES=52428800
MAX_EXTRACTED_BYTES=262144000
MAX_EXTRACTED_FILES=200000
MAX_SINGLE_FILE_BYTES=10485760
DOWNLOAD_TIMEOUT_SECONDS=30

# Partial-analysis budgets. Safe content beyond these budgets is skipped (and
# reported) instead of rejecting the repository. The compressed-archive ceiling is
# derived as max(MAX_ARCHIVE_BYTES, PARTIAL_EXTRACTED_BYTES_BUDGET / 4).
PARTIAL_EXTRACTED_BYTES_BUDGET=1073741824
PARTIAL_EXTRACTED_FILES_BUDGET=150000

# GitHub access. GITHUB_TOKEN is optional and only raises the API rate limit.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Completed analyses keep their extraction workspace for file/source requests.
# The oldest are released once this many completed analyses are retained.
MAX_RETAINED_ANALYSES=10
